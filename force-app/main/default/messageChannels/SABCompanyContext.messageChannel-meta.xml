<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Broadcasts the selected Accounting Company to Simple Accounting Books Lightning components.</description>
    <isExposed>true</isExposed>
    <lightningMessageFields>
        <description>Selected Accounting Company record Id.</description>
        <fieldName>companyId</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>Selected Accounting Company display name.</description>
        <fieldName>companyName</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>Selected Accounting Company key.</description>
        <fieldName>companyKey</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>Selected company functional currency.</description>
        <fieldName>functionalCurrency</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>Selected company setup status.</description>
        <fieldName>setupStatus</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>True when the user switched from one company to another.</description>
        <fieldName>companySwitched</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>True when no authorized Accounting Company is available and subscribers must clear stale company state.</description>
        <fieldName>companyCleared</fieldName>
    </lightningMessageFields>
    <masterLabel>SAB Company Context</masterLabel>
</LightningMessageChannel>
