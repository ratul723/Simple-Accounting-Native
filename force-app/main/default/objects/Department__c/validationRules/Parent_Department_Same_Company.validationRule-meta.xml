<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName>Parent_Department_Same_Company</fullName><active>true</active><description>Prevents cross-company department hierarchies.</description><errorConditionFormula>AND(NOT(ISBLANK(Parent_Department__c)), Parent_Department__r.Company__c &lt;&gt; Company__c)</errorConditionFormula><errorMessage>The Parent Department must belong to the same Accounting Company.</errorMessage></ValidationRule>