<?xml version='1.0' encoding='UTF-8'?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName>AR_Account_Same_Company</fullName><active>true</active><description>Prevents cross-company AR control-account mappings.</description><errorConditionFormula>AND(NOT(ISBLANK(AR_Control_Account__c)), AR_Control_Account__r.Company__c &lt;&gt; Company__c)</errorConditionFormula><errorMessage>AR Control Account must belong to the same Accounting Company.</errorMessage></ValidationRule>